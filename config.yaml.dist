# OpenGoMenu — configuration d'exemple. Copier en config.yaml.
#
# Toute clé peut être fournie par une variable d'environnement préfixée OGM_
# (voir `open-go-menu --help`). Sans fichier config.yaml, seules les variables
# d'environnement et les valeurs par défaut s'appliquent.
#
# Le fuseau horaire qui décide de « aujourd'hui » est celui du processus :
# positionner TZ (ex. TZ=Europe/Paris) si le serveur tourne en UTC.

web:
  # Loopback : exposer l'application derrière un reverse proxy qui termine TLS.
  host: 127.0.0.1
  port: 8080
  # Requêtes par minute et par IP cliente ; 0 désactive la limite.
  rate_limit: 100
  # CIDR du reverse proxy, pour que la limite porte sur les vrais clients.
  trusted_proxies:
    - 127.0.0.1/32
    - ::1/128

logging:
  level: info
  format: text
  source: false

i18n:
  # Langue de repli quand ni ?lang=, ni le cookie, ni Accept-Language ne
  # désignent une langue disponible (fr, en).
  default_language: fr

families:
  # Base des comptes (accounts.db) et une base SQLite par famille (families/).
  data_dir: data
  # Qui peut créer une famille : open (tout le monde), invite (avec un code
  # donné par `open-go-menu invite`), closed (seulement `create-family`).
  signup: invite
  # Une famille sans aucune visite depuis ce nombre de mois est supprimée par
  # `open-go-menu purge` (à lancer chaque jour, cf. deploy/).
  inactive_months: 12
  # Avec signup: invite, les familles peuvent aussi générer des codes depuis
  # leur Compte : chacun valable family_invite_days jours, au plus
  # family_invite_max en attente par famille.
  family_invites: false
  family_invite_days: 7
  family_invite_max: 3

auth:
  # La session glisse à chaque visite et dure 400 jours : on reste connecté
  # jusqu'à « Se déconnecter ». session_ttl n'est donc pas lu.
  cookie_name: session
  # auto : Secure si TLS direct ou X-Forwarded-Proto=https.
  cookie_secure: auto
  bcrypt_cost: 12
